  "components": {
    "schemas": {
      "AnalysisInput": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Dataset Id"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "default": "Market trend review"
          },
          "market_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "maxLength": 80,
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "type": "array",
                "maxItems": 20,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Ids"
          },
          "enable_ml": {
            "type": "boolean",
            "title": "Enable Ml",
            "default": true
          },
          "rsi_low": {
            "type": "number",
            "exclusiveMaximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Rsi Low",
            "default": 30
          },
          "rsi_high": {
            "type": "number",
            "exclusiveMaximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Rsi High",
            "default": 70
          },
          "volume_ratio_limit": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Volume Ratio Limit",
            "default": 2
          },
          "daily_change_limit": {
            "type": "number",
            "maximum": 10.0,
            "exclusiveMinimum": 0.0,
            "title": "Daily Change Limit",
            "default": 0.1
          },
          "volatility_limit": {
            "type": "number",
            "maximum": 10.0,
            "exclusiveMinimum": 0.0,
            "title": "Volatility Limit",
            "default": 0.8
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "as_of"
        ],
        "title": "AnalysisInput"
      },
      "CandleInput": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "market_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Market Id"
          },
          "open": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,29}0*$)\\d{0,16}\\.\\d{0,12}0*$)"
              }
            ],
            "title": "Open"
          },
          "high": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,29}0*$)\\d{0,16}\\.\\d{0,12}0*$)"
              }
            ],
            "title": "High"
          },
          "low": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,29}0*$)\\d{0,16}\\.\\d{0,12}0*$)"
              }
            ],
            "title": "Low"
          },
          "close": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,29}0*$)\\d{0,16}\\.\\d{0,12}0*$)"
              }
            ],
            "title": "Close"
          },
          "volume": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,29}0*$)\\d{0,16}\\.\\d{0,12}0*$)"
              }
            ],
            "title": "Volume"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "market_id",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "CandleInput"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "CsvInput": {
        "properties": {
          "candles_csv": {
            "type": "string",
            "maxLength": 4000000,
            "minLength": 1,
            "title": "Candles Csv"
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "venue": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Venue"
          },
          "coverage_end": {
            "type": "string",
            "format": "date",
            "title": "Coverage End"
          },
          "quote_currency": {
            "type": "string",
            "const": "USD",
            "title": "Quote Currency",
            "default": "USD"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candles_csv",
          "source",
          "venue",
          "coverage_end"
        ],
        "title": "CsvInput"
      },
      "DatasetInput": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "venue": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Venue"
          },
          "quote_currency": {
            "type": "string",
            "const": "USD",
            "title": "Quote Currency",
            "default": "USD"
          },
          "coverage_end": {
            "type": "string",
            "format": "date",
            "title": "Coverage End"
          },
          "candles": {
            "items": {
              "$ref": "#/components/schemas/CandleInput"
            },
            "type": "array",
            "maxItems": 15000,
            "minItems": 1,
            "title": "Candles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "venue",
          "coverage_end",
          "candles"
        ],
        "title": "DatasetInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
